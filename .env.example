# 複製成 .env 後填入實際值（.env 不會上傳到 GitHub）

# PostgreSQL 連線字串（Neon、Supabase 等都會提供）
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# 登入加密用的密鑰，至少 32 個字元的隨機字串
# 可用指令產生：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# （選用）第一次建立資料時的老闆帳號密碼；未設定則自動產生並顯示一次
SEED_ADMIN_PASSWORD=""
